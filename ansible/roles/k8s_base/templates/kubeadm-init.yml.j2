apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens: []
localAPIEndpoint:
  advertiseAddress: {{ k8s_base_policy.node_ip | to_json }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ k8s_base_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ k8s_base_policy.node_ip | to_json }}
patches:
  directory: {{ (k8s_base_bootstrap_dir ~ '/patches') | to_json }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ k8s_base_cluster_name | to_json }}
kubernetesVersion: {{ ('v' ~ k8s_base_bom.versions.kubernetes) | to_json }}
controlPlaneEndpoint: {{ (k8s_base_policy.node_ip ~ ':6443') | to_json }}
imageRepository: registry.k8s.io
networking:
  podSubnet: {{ k8s_base_pod_cidr | to_json }}
  serviceSubnet: {{ k8s_base_service_cidr | to_json }}
  dnsDomain: {{ k8s_base_dns_domain | to_json }}
apiServer:
  certSANs:
    - {{ inventory_hostname | to_json }}
    - {{ k8s_base_policy.node_ip | to_json }}
etcd:
  local:
    imageRepository: registry.k8s.io
    imageTag: {{ (k8s_base_bom.images['registry.k8s.io/etcd'].tag ~ '@' ~ k8s_base_bom.images['registry.k8s.io/etcd'].digest) | to_json }}
dns:
  imageRepository: registry.k8s.io/coredns
  imageTag: {{ (k8s_base_bom.images['registry.k8s.io/coredns/coredns'].tag ~ '@' ~ k8s_base_bom.images['registry.k8s.io/coredns/coredns'].digest) | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
readOnlyPort: 0
rotateCertificates: true
authentication:
  anonymous:
    enabled: false
  webhook:
    enabled: true
authorization:
  mode: Webhook
